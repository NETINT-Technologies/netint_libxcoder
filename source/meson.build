# Equivalent to build/xcoder_auto_headers.h generated by ./configure.
auto_conf = configuration_data()
auto_conf.set('XCODER_DUMP_DATA', get_option('data-dump'))
auto_conf.set('NI_LOG_TRACE_TIMESTAMPS', get_option('tracelog-timestamps'))
auto_conf.set('NI_LOG_SSIM_AT_INFO', get_option('info-level-ssim-log'))
auto_conf.set('XCODER_SELF_KILL_ERR', get_option('self-kill') and not is_windows)
auto_conf.set('MEASURE_LATENCY', get_option('latency-display'))
auto_conf.set('XCODER_LINUX_VIRTIO_DRIVER_ENABLED', get_option('linux-virt-io-driver'))
auto_conf.set('DISABLE_BACKTRACE_PRINT', not get_option('backtrace-print'))
auto_conf.set('XCODER_ENABLE_CPU_AFFINITY', get_option('cpu-affinity'))
auto_conf.set('PRINT_FW_LOGS', get_option('print-fw-logs'))
auto_conf.set('NI_HAVE_MCTF', get_option('mctf'))
configure_file(output : 'xcoder_auto_headers.h', configuration : auto_conf)

# Meson includes both this source directory and its matching build directory.
src_inc = include_directories('.')

lib_sources = files(
  'ni_nvme.c',
  'ni_device_api_priv.c',
  'ni_device_api.c',
  'ni_util.c',
  'ni_lat_meas.c',
  'ni_log.c',
  'ni_rsrc_priv.cpp',
  'ni_rsrc_api.cpp',
  'ni_av_codec.c',
  'ni_bitstream.c',
)

public_headers = files(
  'ni_device_api.h',
  'ni_rsrc_api.h',
  'ni_defs.h',
  'ni_av_codec.h',
  'ni_bitstream.h',
  'ni_util.h',
  'ni_log.h',
  'ni_release_info.h',
)

if not is_windows
  public_headers += files(
    'ni_libxcoder_dynamic_loading.h',
    'ni_p2p_ioctl.h',
    'ni_quadraprobe.h',
    'ni_host_ts.h',
  )
endif

if is_linux
  lib_sources += files('ni_quadraprobe.c', 'ni_host_ts.c')
endif

if get_option('mctf')
  lib_sources += files('mctf.c')
  public_headers += files('mctf.h')
endif

install_headers(public_headers)

# Both variants are always built so the default installation matches build.sh.
libxcoder_static = static_library(
  'xcoder',
  lib_sources,
  include_directories : src_inc,
  dependencies : [platform_deps, mctf_dep],
  install : true,
)
# Unlike version, soversion accepts product revisions such as "---6tGDV".
# On Linux it also creates the required SONAME and unversioned link without
# overriding the target prefix/suffix, so pkgconfig.generate() can safely
# derive -lxcoder from the library target.
if is_linux
  libxcoder_shared = shared_library(
    'xcoder',
    lib_sources,
    include_directories : src_inc,
    dependencies : [platform_deps, mctf_dep],
    soversion : xcoder_revision,
    install : true,
  )
else
  # Preserve build.sh's non-native libxcoder.so.<revision> naming contract on
  # the other supported platforms.
  libxcoder_shared = shared_library(
    'xcoder',
    lib_sources,
    include_directories : src_inc,
    dependencies : [platform_deps, mctf_dep],
    name_prefix : 'lib',
    name_suffix : 'so.' + xcoder_revision,
    install : true,
  )
  install_symlink(
    'libxcoder.so',
    pointing_to : 'libxcoder.so.' + xcoder_revision,
    install_dir : get_option('libdir'),
  )
endif

xcoder_dep = declare_dependency(
  link_with : libxcoder_shared,
  include_directories : src_inc,
  compile_args : public_args,
  dependencies : [platform_deps, mctf_dep],
  variables : {'includedir' : meson.current_source_dir()},
)
meson.override_dependency('xcoder', xcoder_dep)

pkgconfig_libraries = is_linux ? [libxcoder_shared] : [
  '-L${libdir}',
  '-lxcoder',
]
pkgconfig.generate(
  name : 'xcoder',
  description : 'Network Intelligence Xcoder Quadra Codec library',
  version : xcoder_revision,
  libraries : pkgconfig_libraries,
  libraries_private : platform_deps,
  requires_private : get_option('mctf') ? ['nimctf'] : [],
  extra_cflags : public_args,
)

tools = [
  'ni_rsrc_mon',
  'ni_rsrc_namespace',
  'ni_rsrc_update',
  'ni_rsrc_list',
  'init_rsrc',
]
foreach name : tools
  tool_sources = files('@0@.c'.format(name))
  if is_windows
    tool_sources += files('ni_getopt.c')
  endif
  executable(
    name,
    tool_sources,
    dependencies : xcoder_dep,
    install : true,
  )
endforeach

if get_option('tests')
  manual_tests = {'test_rsrc_api' : 'test_rsrc_api.c'}
  if is_linux
    manual_tests += {
      'xcoderp2p' : 'ni_p2p_test.c',
      'xcoderp2p_read' : 'ni_p2p_read_test.c',
    }
  endif
  foreach name, source_file : manual_tests
    executable(name, source_file, dependencies : xcoder_dep)
  endforeach

  if is_linux
    dynamic_loading_test = executable(
      'ni_libxcoder_dynamic_loading_test',
      'ni_libxcoder_dynamic_loading_test.cpp',
      dependencies : xcoder_dep,
    )
    test(
      'dynamic-loading',
      dynamic_loading_test,
      env : {'LD_LIBRARY_PATH' : meson.current_build_dir()},
      timeout : 60,
    )
  endif
endif

if get_option('examples')
  subdir('examples')
endif
