# Equivalent of build/xcoder_auto_headers.h generated by ./configure
auto_conf = configuration_data()
auto_conf.set('XCODER_DUMP_DATA', get_option('data-dump'))
auto_conf.set('NI_LOG_TRACE_TIMESTAMPS', get_option('tracelog-timestamps'))
auto_conf.set('NI_LOG_SSIM_AT_INFO', get_option('info-level-ssim-log'))
auto_conf.set('XCODER_SELF_KILL_ERR', get_option('self-kill') and not is_windows)
auto_conf.set('MEASURE_LATENCY', get_option('latency-display'))
auto_conf.set('XCODER_LINUX_VIRTIO_DRIVER_ENABLED', get_option('linux-virt-io-driver'))
auto_conf.set('DISABLE_BACKTRACE_PRINT', not get_option('backtrace-print'))
auto_conf.set('XCODER_ENABLE_CPU_AFFINITY', get_option('cpu-affinity'))
auto_conf.set('PRINT_FW_LOGS', get_option('print-fw-logs'))
auto_conf.set('NI_HAVE_MCTF', get_option('mctf'))
configure_file(output : 'xcoder_auto_headers.h', configuration : auto_conf)

# Covers both the sources and the generated header
src_inc = include_directories('.')

lib_sources = files(
  'ni_nvme.c',
  'ni_device_api_priv.c',
  'ni_device_api.c',
  'ni_util.c',
  'ni_lat_meas.c',
  'ni_log.c',
  'ni_rsrc_priv.cpp',
  'ni_rsrc_api.cpp',
  'ni_av_codec.c',
  'ni_bitstream.c',
)

headers = files(
  'ni_device_api.h',
  'ni_rsrc_api.h',
  'ni_defs.h',
  'ni_av_codec.h',
  'ni_bitstream.h',
  'ni_util.h',
  'ni_log.h',
  'ni_release_info.h',
)

if not is_windows
  headers += files(
    'ni_libxcoder_dynamic_loading.h',
    'ni_p2p_ioctl.h',
    'ni_quadraprobe.h',
    'ni_host_ts.h',
  )
endif

if is_linux_like
  lib_sources += files('ni_quadraprobe.c', 'ni_host_ts.c')
endif

if get_option('mctf')
  lib_sources += files('mctf.c')
  headers += files('mctf.h')
endif

install_headers(headers)

libxcoder = library('xcoder', lib_sources,
  include_directories : src_inc,
  dependencies : [deps, mctf_dep],
  install : true,
)

xcoder_dep = declare_dependency(
  link_with : libxcoder,
  include_directories : src_inc,
  compile_args : public_args,
)
meson.override_dependency('xcoder', xcoder_dep)

pkgconfig.generate(libxcoder,
  description : 'Network Intelligence Xcoder Quadra Codec library',
  extra_cflags : public_args,
)

tools = ['ni_rsrc_mon', 'ni_rsrc_namespace', 'ni_rsrc_update', 'ni_rsrc_list', 'init_rsrc']
foreach name : tools
  executable(name, '@0@.c'.format(name),
    dependencies : [xcoder_dep, deps],
    install : true,
  )
endforeach

if get_option('tests')
  # Interactive or require Quadra hardware and arguments, so build only
  manual_tests = {'test_rsrc_api' : 'test_rsrc_api.c'}
  if is_linux_like
    manual_tests += {
      'xcoderp2p' : 'ni_p2p_test.c',
      'xcoderp2p_read' : 'ni_p2p_read_test.c',
    }
  endif
  foreach name, src : manual_tests
    executable(name, src,
      dependencies : [xcoder_dep, deps],
    )
  endforeach

  # dlopen()s libxcoder.so and checks all API symbols resolve
  if is_linux_like and get_option('default_library') != 'static'
    dynamic_loading_test = executable('ni_libxcoder_dynamic_loading_test',
      'ni_libxcoder_dynamic_loading_test.cpp',
      dependencies : [xcoder_dep, deps],
    )
    test('dynamic-loading', dynamic_loading_test,
      env : {'LD_LIBRARY_PATH' : meson.current_build_dir()},
    )
  endif
endif

if get_option('examples')
  subdir('examples')
endif
